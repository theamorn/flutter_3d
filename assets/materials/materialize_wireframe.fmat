// Glowing holographic wireframe sweep material adapted from
// bdero/flutter_scene's materialize_wireframe.fmat.
//
// Paired with LineSegmentsGeometry built via MeshData.extractEdges():
// sweeps a NoiseSimplex3-wobbled world-height front upward with a hot
// emissive laser seam that blooms, then fades out behind the fade front.
material {
  name: "MaterializeWireframe",
  shading_model: unlit,
  blending: alpha,
  depth_write: false,
  culling: none,
  parameters: [
    // x = wire_front, y = fade_front, z = edge_width, w = fade_width
    { type: vec4, name: sweep, default: [10.0, -10.0, 0.45, 0.85] },
    // x = noise_amp, y = noise_freq, z = glow_strength, w = base_alpha
    { type: vec4, name: style, default: [0.32, 0.85, 4.2, 0.55] },
    // rgb = wire_color, a = unused
    { type: vec4, name: wire_color, default: [0.18, 0.82, 1.0, 1.0] },
    // rgb = glow_color (blooms at the leading laser seam), a = unused
    { type: vec4, name: glow_color, default: [0.55, 0.96, 1.0, 1.0] },
  ],
}

fragment {
  // flutter_scene 0.24 defaults material fragments to mediump (half precision
  // on Mali/Adreno/web). Keep float32 for world-space simplex noise.
  precision highp float;

  vec3 Mod289v3(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
  vec4 Mod289v4(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
  vec4 Permute(vec4 x) { return Mod289v4(((x * 34.0) + 1.0) * x); }
  vec4 TaylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }

  float NoiseSimplex3(vec3 v) {
    const vec2 C = vec2(1.0 / 6.0, 1.0 / 3.0);
    const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
    vec3 i = floor(v + dot(v, C.yyy));
    vec3 x0 = v - i + dot(i, C.xxx);
    vec3 g = step(x0.yzx, x0.xyz);
    vec3 l = 1.0 - g;
    vec3 i1 = min(g.xyz, l.zxy);
    vec3 i2 = max(g.xyz, l.zxy);
    vec3 x1 = x0 - i1 + C.xxx;
    vec3 x2 = x0 - i2 + C.yyy;
    vec3 x3 = x0 - D.yyy;
    i = Mod289v3(i);
    vec4 p = Permute(Permute(Permute(
               i.z + vec4(0.0, i1.z, i2.z, 1.0))
             + i.y + vec4(0.0, i1.y, i2.y, 1.0))
             + i.x + vec4(0.0, i1.x, i2.x, 1.0));
    float n_ = 0.142857142857;
    vec3 ns = n_ * D.wyz - D.xzx;
    vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
    vec4 x_ = floor(j * ns.z);
    vec4 y_ = floor(j - 7.0 * x_);
    vec4 x = x_ * ns.x + ns.yyyy;
    vec4 y = y_ * ns.x + ns.yyyy;
    vec4 h = 1.0 - abs(x) - abs(y);
    vec4 b0 = vec4(x.xy, y.xy);
    vec4 b1 = vec4(x.zw, y.zw);
    vec4 s0 = floor(b0) * 2.0 + 1.0;
    vec4 s1 = floor(b1) * 2.0 + 1.0;
    vec4 sh = -step(h, vec4(0.0));
    vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
    vec4 a1 = b1.xzyw + s1.xzyw * sh.zzww;
    vec3 p0 = vec3(a0.xy, h.x);
    vec3 p1 = vec3(a0.zw, h.y);
    vec3 p2 = vec3(a1.xy, h.z);
    vec3 p3 = vec3(a1.zw, h.w);
    vec4 norm = TaylorInvSqrt(vec4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
    p0 *= norm.x;
    p1 *= norm.y;
    p2 *= norm.z;
    p3 *= norm.w;
    vec4 m = max(0.6 - vec4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
    m = m * m;
    return 42.0 * dot(m * m, vec4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
  }

  void Surface(inout MaterialInputs material) {
    float wire_front = material_params.sweep.x;
    float fade_front = material_params.sweep.y;
    float edge_width = max(material_params.sweep.z, 1e-4);
    float fade_width = max(material_params.sweep.w, 1e-4);

    float noise_amp = material_params.style.x;
    float noise_freq = material_params.style.y;
    float glow_strength = material_params.style.z;
    float base_alpha = material_params.style.w;

    vec3 world = GetWorldPosition();
    float h = world.y +
              NoiseSimplex3(world * noise_freq) * noise_amp;

    float appear = 1.0 - smoothstep(wire_front - edge_width, wire_front, h);
    float vanish = smoothstep(fade_front - fade_width, fade_front, h);
    float alpha = appear * vanish;

    // Hot emissive pulse along the leading laser scan front.
    float dist_to_front = abs(h - (wire_front - edge_width * 0.5));
    float lead_glow = 1.0 - smoothstep(0.0, edge_width, dist_to_front);
    lead_glow *= lead_glow;

    vec3 color = mix(material_params.wire_color.rgb,
                     material_params.glow_color.rgb,
                     lead_glow);
    float hdr = 1.0 + lead_glow * glow_strength;
    float out_alpha = clamp(alpha * (base_alpha + lead_glow * (1.0 - base_alpha)), 0.0, 1.0);

    // Premultiplied transparent unlit output.
    material.base_color = vec4(color * hdr * out_alpha, out_alpha);
  }
}
