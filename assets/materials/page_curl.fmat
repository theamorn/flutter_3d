material {
  name: "page_curl",
  shading_model: unlit,
  blending: opaque,
  culling: none,
  parameters: [
    { type: float, name: progress },
    { type: float, name: page_width },
    { type: sampler2d, name: page_tex }
  ]
}

vertex {
  void Vertex(inout VertexInputs vertex) {
    float x = vertex.position.x;
    float axis = mix(material_params.page_width, -material_params.page_width * 0.2, material_params.progress);
    float r = 0.05;
    vec3 p = vertex.position;
    if (x > axis) {
      float arc = x - axis;
      float theta = min(arc / r, 3.14159265);
      float flat_arc = max(arc - 3.14159265 * r, 0.0);
      p.x = axis + r * sin(theta) - flat_arc;
      p.z = vertex.position.z + r * (1.0 - cos(theta));
    }
    // 0.24: place the curled object-space point ourselves.
    vertex.world_position = (vertex.model_transform * vec4(p, 1.0)).xyz;
  }
}

fragment {
  // flutter_scene 0.24 defaults material fragments to mediump (half precision
  // on Mali/Adreno/web). This body computes positions, phases and hashes.
  precision highp float;
  void Surface(inout MaterialInputs material) {
    material.base_color = vec4(SRGBToLinear(texture(page_tex, GetUV0()).rgb), 1.0);
  }
}
