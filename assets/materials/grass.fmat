// Super Ultra grass tufts, drawn as one InstancedMesh.
//
// Vertex: quadratic-cantilever wind (tips move, roots stay put), gusts that
// travel across the lawn, and a push away from the player so the character
// parts the grass as it walks.
//
// Fragment: base-to-tip colour from the vertex colour (times the per-instance
// tint), darker roots, and a translucency glow when the low sun is behind
// the blades.
material {
  name: "IslandGrass",
  shading_model: lit,
  culling: none,
  parameters: [
    { type: float, name: time, default: 0.0 },
    // xy = wind direction * strength (m of tip travel), z = sway speed.
    { type: vec4, name: wind, default: [0.16, 0.07, 1.0, 0.0] },
    // xyz = player position, w = push radius (m).
    { type: vec4, name: player, default: [0.0, -100.0, 0.0, 0.85] },
    // xyz = direction toward the key light, w = wetness (rain).
    { type: vec4, name: sun_dir, default: [0.4, 0.5, 0.6, 0.0] },
    // rgb = key light colour * intensity.
    { type: vec4, name: sun_color, default: [1.0, 1.0, 1.0, 0.0] },
    // xyz = campfire world position, w = campfire flicker intensity (0..1).
    { type: vec4, name: campfire, default: [0.0, 0.0, 0.0, 0.0] },
  ],
  varyings: [
    { type: float, name: v_height },
    { type: float, name: v_macro },
  ],
}

vertex {
  // Ashima-style 2D simplex noise (from bdero's campfire_grass.fmat): smooth
  // macro grass regions that drift between short deep-green and tall golden.
  vec3 mod289v3(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
  vec3 permute(vec3 x) { return mod289v3(((x * 34.0) + 1.0) * x); }

  float snoise(vec2 v) {
    const vec4 C = vec4(0.211324865405187, 0.366025403784439,
                        -0.577350269189626, 0.024390243902439);
    vec2 i = floor(v + dot(v, C.yy));
    vec2 x0 = v - i + dot(i, C.xx);
    vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
    vec4 x12 = x0.xyxy + C.xxzz;
    x12.xy -= i1;
    i = i - floor(i * (1.0 / 289.0)) * 289.0;
    vec3 p = permute(
        permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
    vec3 m = max(
        0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
    m = m * m;
    m = m * m;
    vec3 x = 2.0 * fract(p * C.www) - 1.0;
    vec3 h = abs(x) - 0.5;
    vec3 ox = floor(x + 0.5);
    vec3 a0 = x - ox;
    m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
    vec3 g;
    g.x = a0.x * x0.x + h.x * x0.y;
    g.yz = a0.yz * x12.xz + h.yz * x12.yw;
    return 130.0 * dot(m, g);
  }

  void Vertex(inout VertexInputs vertex) {
    // Authored tufts are at most 0.6 m tall in object space.
    float height = clamp(vertex.position.y / 0.6, 0.0, 1.0);
    v_height = height;
    vec3 root = vertex.world_position;

    // Macro meadow field: 0 = short lush green, 1 = taller golden dry-yellow.
    float macro = smoothstep(0.2, 0.8, snoise(root.xz * 0.18) * 0.5 + 0.5);
    v_macro = macro;
    float height_scale = mix(0.84, 1.24, macro);

    float time = material_params.time;
    float phase = dot(root.xz, vec2(0.31, 0.23));
    float gust = 0.55 + 0.45 * sin(time * 0.6 + root.x * 0.07 - root.z * 0.05);
    float sway = 0.6 * sin(time * 1.9 * material_params.wind.z + phase) +
                 0.2 * sin(time * 3.4 + phase * 2.3);
    vec2 bend = material_params.wind.xy * (gust + sway) * height_scale;

    vec2 away = root.xz - material_params.player.xz;
    float distance = length(away);
    float push = 1.0 - smoothstep(0.15, material_params.player.w, distance);
    if (distance > 0.001) {
      bend += away / distance * push * 0.45;
    }

    float k = height * height;
    vertex.world_position.xz += bend * k;
    vertex.world_position.y += (height_scale - 1.0) * vertex.position.y;
    // Keep blade length roughly constant as it leans.
    vertex.world_position.y -= dot(bend, bend) * 0.4 * k;
  }
}

fragment {
  // flutter_scene 0.24 defaults material fragments to mediump (half precision
  // on Mali/Adreno/web). This body computes positions, phases and hashes.
  precision highp float;
  void Surface(inout MaterialInputs material) {
    float wet = material_params.sun_dir.w;
    vec3 palette = mix(vec3(0.85, 1.04, 0.78), vec3(1.22, 1.08, 0.62), v_macro);
    vec3 albedo = GetVertexColor().rgb * palette * (1.0 - 0.18 * wet);
    material.base_color = vec4(albedo, 1.0);
    material.metallic = 0.0;
    material.roughness = mix(0.8, 0.38, wet);
    material.specular = mix(0.3, 0.7, wet);
    material.occlusion = mix(0.4, 1.0, v_height);
    vec3 view_dir = GetViewDirection();
    vec3 to_light = normalize(material_params.sun_dir.xyz);
    float behind = pow(clamp(dot(-view_dir, to_light), 0.0, 1.0), 4.0);
    vec3 sun_trans = albedo * material_params.sun_color.rgb * behind *
                     v_height * 0.8;

    // Warm subsurface glow around the campfire ring at night.
    vec3 to_fire = material_params.campfire.xyz - GetWorldPosition();
    float fire_dist = length(to_fire);
    float fire_atten = clamp(1.0 - fire_dist / 5.2, 0.0, 1.0);
    fire_atten *= fire_atten;
    vec3 fire_dir = fire_dist > 1e-4 ? to_fire / fire_dist : vec3(0.0, 1.0, 0.0);
    float fire_scatter = 0.35 + 0.65 * pow(clamp(dot(-view_dir, fire_dir), 0.0, 1.0), 2.5);
    vec3 fire_trans = albedo * vec3(1.8, 0.82, 0.22) *
                      (material_params.campfire.w * fire_atten * fire_scatter * v_height);

    material.emissive = sun_trans + fire_trans;
  }
}
